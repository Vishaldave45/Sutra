SUTRA_APP_NAME="Sutra API"
SUTRA_ENVIRONMENT="development"
SUTRA_DEBUG=false
SUTRA_API_V1_PREFIX="/api/v1"
SUTRA_LOG_LEVEL="INFO"

# PostgreSQL Configuration
POSTGRES_USER="sutra_user"
POSTGRES_PASSWORD="sutra_password"
POSTGRES_DB="sutra_db"
POSTGRES_PORT=5444

SUTRA_DATABASE_URL="postgresql+psycopg://sutra_user:sutra_password@localhost:5444/sutra_db"
